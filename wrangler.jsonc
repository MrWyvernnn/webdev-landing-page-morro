{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "morrolandingpage",
  "compatibility_date": "2026-11-15",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/confirm", "/unsubscribe"]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "FROM_EMAIL": "Morro <onboarding@resend.dev>",
    "APP_ORIGIN": "https://morrolandingpage.marhaanansari.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "morro-waitlist",
      "database_id": "7954569e-a55a-4f7a-9ffb-192b481a53ac",
      "migrations_dir": "migrations"
    }
  ]
}