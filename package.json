{
  "name": "morro-landing",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "worker:dev": "wrangler dev --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply morro-waitlist --local",
    "db:migrate:remote": "wrangler d1 migrations apply morro-waitlist --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "lenis": "^1.3.11",
    "motion": "^12.23.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.163.0"
  }
}
